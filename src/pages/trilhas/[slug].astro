---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../lib/catalog';
import { sitePath } from '../../lib/site';

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.trilhas.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      lessons: catalog.aulas.filter((lesson) => lesson.data.trackId === entry.id)
    }
  }));
}

const { entry, lessons } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <header class="page-hero">
    <div class="shell">
      <span class="eyebrow">Trilha publicada · {entry.data.level}</span>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <a class="return-link" href={sitePath('trilhas')}>← Todas as trilhas</a>
    </div>
  </header>

  <div class="shell page-content">
    <article class="prose">
      <p class="source-meta">Responsável editorial: {entry.data.author} · Revisada em {entry.data.reviewedAt} · Licença: {entry.data.license}</p>
      <h2>Objetivos deste percurso</h2>
      <ul>{entry.data.objectives.map((objective: string) => <li>{objective}</li>)}</ul>
      <Content />

      <h2>Aulas disponíveis</h2>
      <ol class="lesson-list">
        {lessons.map((lesson) => (
          <li>
            <a href={sitePath('aulas/' + lesson.id)}>{lesson.data.title}</a>
            <span>{lesson.data.durationMinutes} min · {lesson.data.level}</span>
          </li>
        ))}
      </ol>
    </article>
  </div>
</BaseLayout>
